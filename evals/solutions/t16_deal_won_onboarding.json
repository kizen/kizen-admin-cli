[
  {
    "name": "{p} Won Onboarding",
    "api_name": "{p}_won_onboarding",
    "type": "record_based",
    "target_object": "eval_deals",
    "triggers": [
      {
        "trigger_type": "stage_updated",
        "order": 0,
        "trigger_stage_updated": {
          "to_stage": "Closed Won"
        }
      }
    ],
    "steps": [
      {
        "key": "fan_out",
        "parent_key": null,
        "step_type": "branch",
        "order": 0,
        "is_branch_group_initiator": true
      },
      {
        "key": "ticket",
        "parent_key": "fan_out",
        "step_type": "create_related_entity",
        "order": 1,
        "action_create_related_entity": {
          "target_custom_object": "eval_tickets",
          "new_entity_name": "Onboarding: {{ entity_record.name }}",
          "new_entity_name_html": "<p>Onboarding: {{ entity_record.name }}</p>",
          "new_entity_owner_type": "assign_from_context_record",
          "context_entity_field": "eval_deals.onboarding_ticket"
        }
      },
      {
        "key": "ticket_urgent",
        "parent_key": "ticket",
        "step_type": "modify_related_entities",
        "order": 2,
        "action_modify_related_entities": {
          "object_to_modify": "eval_tickets",
          "automation_target_relationship_fields": [
            "eval_deals.onboarding_ticket"
          ],
          "fields_to_modify": [
            {
              "field_to_modify": "eval_tickets.priority",
              "value_type": "specific_value",
              "specific_field_value": "Urgent"
            }
          ]
        }
      },
      {
        "key": "flag_account",
        "parent_key": "fan_out",
        "step_type": "modify_related_entities",
        "order": 3,
        "action_modify_related_entities": {
          "object_to_modify": "eval_accounts",
          "automation_target_relationship_fields": [
            "eval_deals.account"
          ],
          "fields_to_modify": [
            {
              "field_to_modify": "eval_accounts.flagged",
              "value_type": "specific_value",
              "specific_field_value": true
            }
          ]
        }
      },
      {
        "key": "rejoin",
        "parent_key": "fan_out",
        "step_type": "merge_branches",
        "order": 4
      },
      {
        "key": "next_step",
        "parent_key": "rejoin",
        "step_type": "change_field_value",
        "order": 5,
        "action_change_field_value": {
          "field_ref": "eval_deals.next_step",
          "specific_field_value": "Kick off onboarding"
        }
      }
    ]
  }
]
