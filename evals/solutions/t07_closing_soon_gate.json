[
  { "name": "{p} Closing Soon", "api_name": "{p}_closing_soon",
    "type": "record_based", "target_object": "eval_deals",
    "triggers": [ { "trigger_type": "on_or_around_date", "order": 0,
                    "trigger_on_or_around_date": { "field_ref": "eval_deals.close_date",
                      "date_offset": "days_before", "date_offset_days": 3,
                      "time": "09:00", "period": "am" } } ],
    "steps": [
      { "key": "big", "parent_key": null, "step_type": "condition", "order": 0,
        "step_condition": { "type": "custom_filter", "filter_config": { "all": [
          { "field": "amount", "op": ">=", "value": 50000 } ] } } },
      { "key": "text_owner", "parent_key": "big", "parent_branch": "yes",
        "step_type": "notify_member_via_text", "order": 1,
        "action_notify_member_via_text": { "team_member": { "type": "owner" },
          "content": "Closing soon: {{ entity_record.name }}" } },
      { "key": "cancel", "parent_key": "big", "parent_branch": "no",
        "step_type": "stop_execution", "order": 2,
        "action_stop_execution": { "action": "stop_and_cancel" } }
    ] }
]
