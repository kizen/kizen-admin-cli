[
  {
    "name": "{p} Tier Sweep",
    "api_name": "{p}_tier_sweep",
    "type": "global",
    "triggers": [
      {
        "trigger_type": "manual",
        "order": 0,
        "trigger_manual": {}
      }
    ],
    "steps": [
      {
        "key": "tiers",
        "parent_key": null,
        "step_type": "initialize_variable",
        "order": 0,
        "action_initialize_variable": {
          "sources": [
            {
              "source_type": "static",
              "source_subtype": "string",
              "value": [
                "Premium",
                "Enterprise"
              ],
              "array_separator": "comma"
            }
          ],
          "variable": {
            "name": "target_tiers",
            "data_type": "string",
            "is_array": true
          },
          "array_aggregation_mode": "add_all"
        }
      },
      {
        "key": "log",
        "parent_key": "tiers",
        "step_type": "initialize_variable",
        "order": 1,
        "action_initialize_variable": {
          "sources": [],
          "variable": {
            "name": "sweep_log",
            "data_type": "string",
            "is_array": true
          },
          "array_aggregation_mode": "add_all"
        }
      },
      {
        "key": "accounts",
        "parent_key": "log",
        "step_type": "initialize_variable",
        "order": 2,
        "action_initialize_variable": {
          "sources": [],
          "variable": {
            "name": "accounts",
            "data_type": "entity",
            "is_array": true,
            "data_subtype": "<eval_accounts>"
          },
          "array_aggregation_mode": "add_all"
        }
      },
      {
        "key": "account",
        "parent_key": "accounts",
        "step_type": "initialize_variable",
        "order": 3,
        "action_initialize_variable": {
          "sources": [],
          "variable": {
            "name": "accounts_item",
            "data_type": "entity",
            "data_subtype": "<eval_accounts>"
          }
        }
      },
      {
        "key": "find",
        "parent_key": "account",
        "step_type": "search_records",
        "order": 4,
        "action_search_records": {
          "custom_object": "eval_accounts",
          "filter_type": "custom_filter",
          "filter_config": {
            "all": [
              {
                "field": "tier",
                "op": "is_any_of",
                "variable": "target_tiers"
              }
            ]
          },
          "destination_variable": "accounts",
          "destination_variable_resolution": "overwrite"
        }
      },
      {
        "key": "each",
        "parent_key": "find",
        "step_type": "loop",
        "order": 5,
        "description": "For each item in 'accounts'",
        "step_loop": {
          "array_variable": "accounts",
          "item_variable": "accounts_item"
        }
      },
      {
        "key": "flag",
        "parent_key": "each",
        "step_type": "modify_related_entities",
        "order": 6,
        "action_modify_related_entities": {
          "object_to_modify": "eval_accounts",
          "record_source": "automation_variable",
          "record_source_variables": [
            "accounts_item"
          ],
          "automation_target_relationship_fields": [],
          "fields_to_modify": [
            {
              "field_to_modify": "eval_accounts.flagged",
              "value_type": "specific_value",
              "specific_field_value": true
            }
          ]
        }
      },
      {
        "key": "next",
        "parent_key": "each",
        "step_type": "next_or_finish",
        "order": 7
      },
      {
        "key": "log_done",
        "parent_key": "next",
        "step_type": "update_variable",
        "order": 8,
        "action_update_variable": {
          "variable": {
            "name": "sweep_log",
            "data_type": "string",
            "is_array": true
          },
          "sources": [
            {
              "source_type": "static",
              "source_subtype": "string",
              "value": [
                "sweep complete"
              ],
              "array_separator": "comma"
            }
          ],
          "array_aggregation_mode": "add_all",
          "value_resolution": "add_only"
        }
      }
    ]
  }
]
