[
  {
    "name": "{p} Secured Webhook",
    "api_name": "{p}_secured_webhook",
    "type": "record_based",
    "target_object": "eval_tickets",
    "triggers": [
      {
        "trigger_type": "webhook",
        "order": 0,
        "trigger_webhook": {
          "name": "{p}_inbound",
          "auth_type": "http_header",
          "headers": [
            {
              "name": "X-Eval-Token",
              "value": "evaltoken123"
            }
          ]
        }
      }
    ],
    "steps": [
      {
        "key": "v_tag",
        "parent_key": null,
        "step_type": "initialize_variable",
        "order": 0,
        "action_initialize_variable": {
          "sources": [],
          "variable": {
            "name": "ticket_tag",
            "data_type": "string"
          }
        }
      },
      {
        "key": "tag",
        "parent_key": "v_tag",
        "step_type": "code_step",
        "order": 1,
        "action_code_step": {
          "script": "# Tag a ticket from its subject. `mode` is \"strict\" or \"loose\".\nsubject = (inputs.subject or \"\").lower()\nwords = (\"vip\", \"priority\") if inputs.mode == \"loose\" else (\"vip\",)\noutputs.tag = \"vip\" if any(w in subject for w in words) else \"standard\"",
          "inputs": [
            {
              "name": "subject",
              "input_type": "field",
              "field_ref": "eval_tickets.subject",
              "data_type": "string"
            },
            {
              "name": "mode",
              "input_type": "static_value",
              "static_value": "strict",
              "data_type": "string"
            }
          ],
          "outputs": [
            {
              "name": "tag",
              "output_type": "variable",
              "variable_name": "ticket_tag",
              "data_type": "string"
            }
          ]
        }
      },
      {
        "key": "is_vip",
        "parent_key": "tag",
        "step_type": "condition",
        "order": 2,
        "step_condition": {
          "type": "custom_filter",
          "filter_config": {
            "and": true,
            "query": [
              {
                "id": "query-0",
                "and": true,
                "filters": [
                  {
                    "type": "variable",
                    "subtype": "automation_variable",
                    "lhs_variable_name": "ticket_tag",
                    "condition": "=",
                    "rhs_value": "vip",
                    "rhs_value_type": "static"
                  }
                ]
              }
            ],
            "invalid": false
          }
        }
      },
      {
        "key": "urgent",
        "parent_key": "is_vip",
        "parent_branch": "yes",
        "step_type": "change_field_value",
        "order": 3,
        "action_change_field_value": {
          "field_ref": "eval_tickets.priority",
          "specific_field_value": "Urgent"
        }
      }
    ]
  }
]
