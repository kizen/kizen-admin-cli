[
  {
    "name": "{p} KB Draft",
    "api_name": "{p}_kb_draft",
    "type": "record_based",
    "target_object": "eval_tickets",
    "triggers": [
      {
        "trigger_type": "manual",
        "order": 0,
        "trigger_manual": {}
      }
    ],
    "steps": [
      {
        "key": "answer",
        "parent_key": null,
        "step_type": "initialize_variable",
        "order": 0,
        "action_initialize_variable": {
          "sources": [],
          "variable": {
            "name": "draft_answer",
            "data_type": "string"
          }
        }
      },
      {
        "key": "draft",
        "parent_key": "answer",
        "step_type": "call_llm",
        "order": 1,
        "action_call_llm": {
          "model_name": "kizen/pro",
          "mcp_server": "readonly",
          "run_tools_as": "Agentic Workflow Code",
          "merge_field_validation": "default_to_unknown",
          "prompt": "Search the knowledge catalog for this support request, then draft a short answer. Request subject: {{ custom_objects.subject }}",
          "destinations": [
            {
              "variable": "draft_answer"
            }
          ]
        }
      },
      {
        "key": "save",
        "parent_key": "draft",
        "step_type": "change_field_value",
        "order": 2,
        "action_change_field_value": {
          "field_ref": "eval_tickets.summary",
          "change_type": "variable",
          "variable": "draft_answer"
        }
      }
    ]
  }
]
