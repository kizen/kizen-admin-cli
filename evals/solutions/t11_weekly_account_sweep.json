[
  { "name": "{p} Weekly Sweep", "api_name": "{p}_weekly_sweep", "type": "global",
    "triggers": [ { "trigger_type": "schedule", "order": 0,
                    "description": "Mondays at 13:00 UTC",
                    "trigger_schedule": {
                      "rrule": "DTSTART:20261102T130000Z\nRRULE:FREQ=WEEKLY;BYDAY=MO",
                      "is_advanced": false } } ],
    "steps": [
      { "key": "flagged", "parent_key": null, "step_type": "initialize_variable", "order": 0,
        "action_initialize_variable": { "sources": [], "array_aggregation_mode": "add_all",
          "variable": { "name": "flagged_accounts", "data_type": "entity", "is_array": true,
                        "data_subtype": "<eval_accounts>" } } },
      { "key": "find", "parent_key": "flagged", "step_type": "search_records", "order": 1,
        "action_search_records": { "custom_object": "eval_accounts",
          "filter_type": "custom_filter",
          "filter_config": { "all": [ { "field": "flagged", "op": "is_checked" } ] },
          "destination_variable": "flagged_accounts",
          "destination_variable_resolution": "overwrite" } },
      { "key": "review_each", "parent_key": "find", "step_type": "start_automation", "order": 2,
        "action_start_automation": { "record_source": "automation_variable",
          "automation_variable_name": "flagged_accounts",
          "automation_ids": ["{p}_account_review"] } }
    ] }
]
